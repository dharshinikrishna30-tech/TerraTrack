# ====================================================================
# EcoPulse – Track. Measure. Reduce. Environment Configuration
# ====================================================================

# Port for Express API Server (default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection URI (e.g. MongoDB Atlas connection string)
# NOTE: If left empty or omitted, EcoPulse will automatically spin up
# an embedded in-memory MongoDB engine for zero-configuration local use!
MONGODB_URI=

# JWT Authentication Secret Key
JWT_SECRET=ecopulse_super_secret_jwt_key_prod_2026_change_in_production

# Optional: Google Gemini API Key for dynamic AI Sustainability Advisor
# If left blank, EcoPulse utilizes its built-in GHG Protocol rule-based engine
GEMINI_API_KEY=
